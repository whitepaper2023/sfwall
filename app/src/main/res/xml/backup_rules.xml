<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules (Android 11 and below; Android 12+ uses data_extraction_rules.xml).
     The automation token (SfWallSecrets) and the LADB daemon token
     (daemon_prefs) must never leave the device in a backup. The firewall
     history log (firewall_history.json) is device-local diagnostics and
     stays behind too. Everything else (firewall settings, block list,
     profiles) keeps backing up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="SfWallSecrets.xml" />
    <exclude domain="sharedpref" path="daemon_prefs.xml" />
    <exclude domain="file" path="firewall_history.json" />
</full-backup-content>
